---
import Icon from "blume/components/Icon.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import {
  demoCpUrl,
  demoLogin,
  demoUrl,
  easyFormsUrl,
  githubUrl,
  issuesUrl,
  license,
  livewireFiltersUrl,
  marketplaceUrl,
  partnerUrl,
  price,
  reachUrl,
  requirements,
  sellerUrl,
  supportEmail,
} from "../site";

// The home page: a product page for Resrv, built on Blume's full-width layout. The docs start
// at /introduction. Every claim here is covered by the docs page linked beside it: change both
// together. The screenshots in public/home/ come from the Resrv Hotel demo, and the control
// panel ones have a light and a dark version that swap with the site's theme. The smaller
// panels redraw the control panel in HTML with the demo's own names and numbers.

const { config } = data;
const host = (url: string) => new URL(url).host;

const uses = [
  {
    icon: "bed-double",
    title: "Hotels and rentals",
    text: "Nightly prices, room types as rates, and breakfast as an option.",
    link: { label: "Rates", href: "/rates" },
  },
  {
    icon: "utensils",
    title: "Restaurants",
    text: "Lunch and dinner sittings by date. Set the price to zero and guests book without paying.",
    link: { label: "Checkout", href: "/checkout" },
  },
  {
    icon: "compass",
    title: "Tours and excursions",
    text: "Guests add several rates and dates to a cart and pay for them in one checkout.",
    link: { label: "Cart booking", href: "/cart-booking" },
  },
  {
    icon: "flower-2",
    title: "Spas and wellness",
    text: "Treatments by the day, with the price of each day shown in the date picker.",
    link: { label: "Single entry search", href: "/availability-search-single" },
  },
  {
    icon: "car",
    title: "Car and boat rentals",
    text: "A price for each rental length, and a fee when pickup and return differ.",
    link: { label: "Fixed pricing", href: "/fixed-pricing" },
  },
  {
    icon: "ticket",
    title: "Conferences and events",
    text: "A set number of places, and a checkout form you build in Statamic.",
    link: { label: "Checkout form", href: "/checkout" },
  },
];

const fieldtypes = ["Resrv Availability", "Resrv Options", "Resrv Extras", "Resrv Fixed Pricing", "Resrv Cutoff"];

// The Sea View Suite's first two weeks of November 2026 in the demo: 3 free a day,
// €320 on weekdays and €368 on Fridays and Saturdays.
const calendarDays = Array.from({ length: 14 }, (_, i) => ({
  day: i + 1,
  price: i % 7 >= 5 ? "368" : "320",
}));

const screens = [
  {
    id: "list",
    label: "Reservations",
    path: "reservations",
    width: 1800,
    height: 909,
    alt: "Resrv's Reservations list in the Statamic control panel: five confirmed bookings with their entry, rate, dates, deposit, total and customer, and a Create reservation button.",
  },
  {
    id: "calendar",
    label: "Calendar",
    path: "reservations/calendar",
    width: 1800,
    height: 1267,
    alt: "The Reservations Calendar for July 2026, with two Garden View Double bookings drawn as bars across their dates.",
  },
  {
    id: "reports",
    label: "Reports",
    path: "reports",
    width: 1800,
    height: 1267,
    alt: "Reports for 2026: 6 reservations, €4,712.60 revenue, €785.43 average value, and a best sellers table by entry.",
  },
  {
    id: "create",
    label: "New booking",
    path: "reservations/create",
    width: 1800,
    height: 1267,
    alt: "The Create reservation form filled in for the Sea View Suite, 14 to 18 December 2026, with an airport transfer and Continental breakfast, and a summary showing the dynamic pricing discount and a €1,229.40 total.",
  },
];

// The demo's rates for the Rooms collection, as its Rates screen lists them.
const rates = [
  { name: "Best Flexible", child: false, badges: ["All entries", "3 derived rates"] },
  { name: "Bed & Breakfast", child: true, badges: ["Relative", "Shared"] },
  { name: "Advance Saver", child: true, badges: ["Non-refundable", "Relative", "Shared"] },
  { name: "Last-Minute Escape", child: true, badges: ["Non-refundable", "Relative", "Shared"] },
];

const campaigns = [
  { n: 1, title: "Stay 7+ nights: save 10%" },
  { n: 2, title: "Early bird: book 30+ days ahead, save 12%" },
  { n: 3, title: "COASTAL10: 10% off" },
];

const details = [
  {
    icon: "calendar-check",
    title: "Guests manage their booking",
    text: "A status page where guests look up a booking and cancel it within the free cancellation window.",
    href: "/reservation-status",
  },
  {
    icon: "mail",
    title: "Emails you can edit",
    text: "Confirmation, refund and abandoned checkout emails, with subjects and recipients set in the control panel.",
    href: "/emails",
  },
  {
    icon: "languages",
    title: "In your site's languages",
    text: "Translate the frontend's text for each site of a Statamic multisite.",
    href: "/languages",
  },
  {
    icon: "timer",
    title: "Cutoff times",
    text: "Stop bookings a set number of hours before an activity starts.",
    href: "/cutoff",
  },
  {
    icon: "history",
    title: "Activity log",
    text: "See who changed a price or the availability for a date, and when.",
    href: "/activity-log",
  },
  {
    icon: "file-spreadsheet",
    title: "CSV export",
    text: "Export reservations with the columns you pick, custom checkout fields included.",
    href: "/reservations#export",
  },
  {
    icon: "palette",
    title: "Your templates",
    text: "Publish the Blade views and style them with Tailwind and CSS variables.",
    href: "/frontend-setup",
  },
  {
    icon: "plug",
    title: "Any payment provider",
    text: "Write a gateway class for a provider Resrv doesn't support yet.",
    href: "/custom-payment-gateway",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/brand/link-preview-1200x630-light.png"
  ogImageAlt="Resrv"
  ogImageSize={{ width: 1200, height: 630 }}
  x={config.x}
  structuredDataEnabled={config.structuredData}
  page={{
    title: "Resrv: a booking system for Statamic",
    description: config.description,
    route: "/",
  }}
>
  <link rel="preload" href="/home/fonts/archivo-wide.woff2" as="font" type="font/woff2" crossorigin />

  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <a class="news" href="/manual-reservations">
          <span class="news-tag">New in 6.5</span>
          <span class="news-text">Take bookings by phone and email a payment link</span>
          <Icon name="arrow-right" size={14} />
        </a>
        <h1 id="hero-title">Make any Statamic entry bookable</h1>
        <div class="hero-row">
          <p class="lead">
            Resrv adds availability, rates, extras, checkout and payments to your Statamic site. Guests
            book rooms, tables or tours on your pages, and you manage every reservation in the control
            panel.
          </p>
          <div class="hero-side">
            <div class="actions">
              <a class="btn btn-primary" href="#demo">
                Try the live demo <Icon name="arrow-down" size={16} />
              </a>
              <a class="btn btn-secondary" href={marketplaceUrl}>Buy for {price}</a>
              <a class="btn btn-link" href="/introduction">Read the docs</a>
            </div>
            <ul class="facts" aria-label="At a glance">
              <li><Icon name="check" size={14} /> One-time {price}</li>
              <li><Icon name="check" size={14} /> Statamic {requirements.statamic}</li>
              <li><Icon name="check" size={14} /> Livewire frontend</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="wrap stage">
        <figure class="shot shot-site">
          <div class="frame">
            <div class="bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="address"><Icon name="lock" size={11} /> {host(demoUrl)}/rooms</span>
            </div>
            <img
              src="/home/hero-site.webp"
              width="1600"
              height="1000"
              fetchpriority="high"
              alt="The Resrv Hotel demo's rooms page after a search for 14 to 18 December: four rooms, each with a discounted total price, a free cancellation date and a Book now button."
            />
          </div>
          <figcaption><span class="dot is-orange"></span>Guests book on your site</figcaption>
        </figure>
        <figure class="shot shot-cp">
          <div class="frame">
            <div class="bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="address"><Icon name="lock" size={11} /> {host(demoCpUrl)}/cp/resrv/reservations</span>
            </div>
            <img
              class="is-light"
              src="/home/hero-cp-light.webp"
              width="1600"
              height="752"
              alt="Resrv's Reservations list in the Statamic control panel, with five confirmed bookings and their entries, rates, dates, totals and customers."
            />
            <img
              class="is-dark"
              src="/home/hero-cp-dark.webp"
              width="1600"
              height="752"
              alt="Resrv's Reservations list in the Statamic control panel, with five confirmed bookings and their entries, rates, dates, totals and customers."
            />
          </div>
          <figcaption><span class="dot is-amber"></span>You manage them in Statamic</figcaption>
        </figure>
      </div>
    </section>

    <section class="section" aria-labelledby="who-title">
      <div class="wrap who">
        <div class="who-text">
          <h2 id="who-title">For Statamic sites that take bookings</h2>
          <p>
            Resrv is for developers and agencies who build with Statamic, and for the businesses they
            build for. You set up the collections and templates. Your client manages availability,
            prices and reservations in the control panel.
          </p>
          <p>
            Any entry can be bookable, so one site can rent rooms from one collection and cars from
            another.
          </p>
          <a class="more" href="/core-concepts">How Resrv works <Icon name="arrow-right" size={14} /></a>
        </div>
        <ul class="uses">
          {
            uses.map((use) => (
              <li>
                <span class="use-icon">
                  <Icon name={use.icon} size={20} />
                </span>
                <div>
                  <h3>{use.title}</h3>
                  <p>
                    {use.text} <a href={use.link.href}>{use.link.label}</a>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section tinted" aria-labelledby="how-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="how-title">From entry to booking in three steps</h2>
          <p>Resrv builds on Statamic's entries, blueprints and forms, so it fits into a site you already have.</p>
        </header>
        <div class="track" aria-hidden="true"><i></i><i></i><i></i></div>
        <ol class="steps">
          <li class="step">
            <div class="step-text">
              <span class="step-num">1</span>
              <h3>Add the availability field</h3>
              <p>Add a Resrv Availability field to a collection's blueprint. Each entry in it can now take bookings.</p>
              <a class="more" href="/availability">Availability <Icon name="arrow-right" size={14} /></a>
            </div>
            <div class="step-visual" aria-hidden="true">
              <div class="cp-card">
                <p class="cp-head">Add field</p>
                <div class="cp-body">
                  <p class="cp-search"><Icon name="search" size={13} /> resrv</p>
                  <p class="cp-group">Special</p>
                  <ul class="fieldtypes">
                    {
                      fieldtypes.map((name, i) => (
                        <li class:list={{ "is-active": i === 0 }}>
                          <Icon name={i === 0 ? "calendar-days" : "square-plus"} size={14} />
                          {name}
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </li>
          <li class="step">
            <div class="step-text">
              <span class="step-num">2</span>
              <h3>Set availability and prices</h3>
              <p>Fill each entry's calendar with how many are free and what they cost. Add rates for room types or pricing tiers.</p>
              <a class="more" href="/rates">Rates <Icon name="arrow-right" size={14} /></a>
            </div>
            <div class="step-visual" aria-hidden="true">
              <div class="cp-card">
                <p class="cp-head"><span>November 2026</span><span class="cp-select">Best Flexible <Icon name="chevron-down" size={12} /></span></p>
                <div class="cal">
                  {["S", "M", "T", "W", "T", "F", "S"].map((d) => <span class="cal-dow">{d}</span>)}
                  {
                    calendarDays.map((d) => (
                      <span class="cal-day">
                        <b>{d.day}</b>
                        <i># 3</i>
                        <small>€{d.price}</small>
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
          </li>
          <li class="step">
            <div class="step-text">
              <span class="step-num">3</span>
              <h3>Add the Livewire components</h3>
              <p>Put the search and results components in your templates. The checkout component handles extras, the guest's details and payment.</p>
              <a class="more" href="/frontend-setup">Frontend setup <Icon name="arrow-right" size={14} /></a>
            </div>
            <div class="step-visual" aria-hidden="true">
              <div class="code">
                <p class="code-file">rooms/show.antlers.html</p>
                <pre><code><span class="t">{"{{ livewire:availability-search"}</span>
    <span class="a">:entry</span>=<span class="s">"id"</span> <span class="t">{"}}"}</span>
<span class="t">{"{{ livewire:availability-results"}</span>
    <span class="a">:entry</span>=<span class="s">"id"</span> <span class="t">{"}}"}</span></code></pre>
                <p class="code-file">checkout.antlers.html</p>
                <pre><code><span class="t">{"{{ livewire:checkout }}"}</span></code></pre>
              </div>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="rates-title">
      <div class="wrap split">
        <div class="split-text">
          <h2 id="rates-title">Availability and prices for every day</h2>
          <p>
            Each entry has its own calendar. Set how many units are free and what they cost, one day at a
            time or in bulk by weekday.
          </p>
          <ul class="ticks">
            <li><Icon name="check" size={16} /><span>Rates for room types or pricing tiers, with their own prices or a percentage off a base rate.</span></li>
            <li><Icon name="check" size={16} /><span>Rates can share one inventory, so a room booked at one rate is gone from all of them.</span></li>
            <li><Icon name="check" size={16} /><span>Minimum and maximum stays, plus early bird and last minute windows, for each rate.</span></li>
            <li><Icon name="check" size={16} /><span>A free cancellation period for each rate, or none at all with a non-refundable rate.</span></li>
          </ul>
          <a class="more" href="/rates">Rates <Icon name="arrow-right" size={14} /></a>
        </div>
        <div class="split-visual pairing">
          <div class="cp-card rates-card" aria-hidden="true">
            <p class="cp-head"><span>Rates</span><span class="cp-btn">Add rate</span></p>
            <div class="cp-body">
              <p class="cp-label">Collection</p>
              <p class="cp-field">Rooms <Icon name="chevron-down" size={12} /></p>
              <ul class="rate-tree">
                {
                  rates.map((rate) => (
                    <li class:list={{ "is-child": rate.child }}>
                      <span class="grip" />
                      <span class="live" />
                      <strong>{rate.name}</strong>
                      <span class="badges">
                        {rate.badges.map((badge) => <span class="cp-badge">{badge}</span>)}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class="window window-widget">
            <img
              src="/home/room-rates.webp"
              width="800"
              height="1450"
              loading="lazy"
              alt="The demo hotel's booking box for the Sea View Suite, 14 to 18 December: Best Flexible at €282 a night, Bed & Breakfast at €304, Advance Saver at €231 and non-refundable, and Last-Minute Escape with no availability."
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section tinted" aria-labelledby="checkout-title">
      <div class="wrap split is-reversed">
        <div class="split-text">
          <h2 id="checkout-title">A checkout with extras, coupons and payments</h2>
          <p>
            The checkout component takes guests from extras to their details to payment. You build the
            form in Statamic's form builder.
          </p>
          <ul class="ticks">
            <li><Icon name="check" size={16} /><span>Extras priced per booking, per day or from the total, and shown, hidden or required by conditions.</span></li>
            <li><Icon name="check" size={16} /><span>Options for choices like breakfast or bed type, and coupon codes for discounts.</span></li>
            <li><Icon name="check" size={16} /><span>Take the full amount, a fixed deposit or a percentage up front.</span></li>
            <li><Icon name="check" size={16} /><span>Offer several gateways at checkout, each with its own surcharge and order limits.</span></li>
          </ul>
          <ul class="gateways" aria-label="Payment gateways">
            <li><a href="/stripe">Stripe</a></li>
            <li><a href="/payment-gateways#the-offline-gateway">Bank transfer</a></li>
            <li><a href="/mollie">Mollie <small>add-on</small></a></li>
            <li><a href="/custom-payment-gateway">Your own</a></li>
          </ul>
          <a class="more" href="/checkout">Checkout <Icon name="arrow-right" size={14} /></a>
        </div>
        <div class="split-visual layered">
          <div class="window window-paper">
            <img
              src="/home/checkout-extras.webp"
              width="1400"
              height="1243"
              loading="lazy"
              alt="The demo's checkout, step 1 of 3, Extras and options: Continental breakfast and a King bed chosen, and the airport transfer switched on."
            />
          </div>
          <div class="window window-float window-summary">
            <img
              src="/home/checkout-summary.webp"
              width="848"
              height="1340"
              loading="lazy"
              alt="The checkout summary for the Sea View Suite, 14 to 18 December: the COASTAL10 coupon applied, breakfast, bed setup, airport transfer and champagne, and a €1,161.76 total."
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="manage-title">
      <div class="wrap">
        <div class="manage-head">
          <div>
            <h2 id="manage-title">Every booking in the control panel</h2>
            <p>
              Reservations live in Statamic next to your content, so your client manages them with the
              login they already have.
            </p>
            <a class="more" href="/reservations">Reservations <Icon name="arrow-right" size={14} /></a>
          </div>
          <ul class="ticks">
            <li><Icon name="check" size={16} /><span>Filter by entry, status and dates, and open any booking for its details.</span></li>
            <li><Icon name="check" size={16} /><span>Refund through the gateway the guest paid with, and the availability comes back.</span></li>
            <li><Icon name="check" size={16} /><span>Book for a guest on the phone and email them a link to pay. <a href="/manual-reservations">Manual reservations</a></span></li>
            <li><Icon name="check" size={16} /><span>See revenue and best sellers in reports, and export to CSV.</span></li>
          </ul>
        </div>

        <div class="viewer" data-viewer>
          <div class="tabs" role="tablist" aria-label="Control panel screens">
            {
              screens.map((screen, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${screen.id}`}
                  aria-controls={`panel-${screen.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {screen.label}
                </button>
              ))
            }
          </div>
          {
            screens.map((screen, i) => (
              <div
                class="window window-cp"
                role="tabpanel"
                id={`panel-${screen.id}`}
                aria-labelledby={`tab-${screen.id}`}
                hidden={i !== 0}
              >
                <div class="bar" aria-hidden="true">
                  <span class="dots"><i></i><i></i><i></i></span>
                  <span class="address">
                    <Icon name="lock" size={11} /> {host(demoCpUrl)}/cp/resrv/{screen.path}
                  </span>
                </div>
                <img
                  class="is-light"
                  src={`/home/cp-${screen.id}-light.webp`}
                  width={screen.width}
                  height={screen.height}
                  loading="lazy"
                  alt={screen.alt}
                />
                <img
                  class="is-dark"
                  src={`/home/cp-${screen.id}-dark.webp`}
                  width={screen.width}
                  height={screen.height}
                  loading="lazy"
                  alt={screen.alt}
                />
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section tinted" aria-labelledby="pricing-rules-title">
      <div class="wrap split">
        <div class="split-text">
          <h2 id="pricing-rules-title">Discounts, coupons and affiliates</h2>
          <p>
            Change prices by the dates of a stay, its length, its price or how far ahead it's booked.
            Rules apply one after another, in the order you set.
          </p>
          <ul class="ticks">
            <li><Icon name="check" size={16} /><span>Raise or lower prices by a percentage or a fixed amount, on entries and extras.</span></li>
            <li><Icon name="check" size={16} /><span>Set a minimum or a maximum price, applied after every other rule and coupon.</span></li>
            <li><Icon name="check" size={16} /><span>Coupons take the same conditions, and guests enter them at checkout.</span></li>
            <li><Icon name="check" size={16} /><span>Affiliate links credit partners for the bookings they send, with a fee you track.</span></li>
          </ul>
          <a class="more" href="/dynamic-pricing">Dynamic pricing <Icon name="arrow-right" size={14} /></a>
          <a class="more more-gap" href="/affiliates">Affiliates <Icon name="arrow-right" size={14} /></a>
        </div>
        <div class="split-visual stack" aria-hidden="true">
          <div class="cp-card">
            <p class="cp-head"><span>Dynamic Pricing</span><span class="cp-btn">Add Dynamic Pricing</span></p>
            <ul class="campaigns">
              {
                campaigns.map((c) => (
                  <li>
                    <span class="live"></span>
                    <span class="cp-tag">#{c.n}</span>
                    {c.title}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="pair">
            <div class="cp-card">
              <p class="cp-head">Summary</p>
              <div class="cp-body summary">
                <p class="summary-entry">
                  <strong>Sea View Suite</strong>
                  <span>Dec 14 to Dec 18, 2026, 4 nights</span>
                </p>
                <dl>
                  <div><dt>Base price</dt><dd>€ 1280.00</dd></div>
                  <div class="is-discount"><dt>Dynamic pricing discount</dt><dd>− € 153.60</dd></div>
                  <div class="is-total"><dt>Total</dt><dd>€ 1126.40</dd></div>
                </dl>
              </div>
            </div>
            <div class="cp-card">
              <p class="cp-head">Affiliate</p>
              <div class="cp-body affiliate">
                <strong>Mediterranean Travel Co</strong>
                <code>?afid=MEDTRAVEL</code>
                <dl>
                  <div><dt>Fee</dt><dd>8%</dd></div>
                  <div><dt>Cookie</dt><dd>30 days</dd></div>
                  <div><dt>Sales</dt><dd>€ 720</dd></div>
                  <div><dt>Commission</dt><dd>€ 57.60</dd></div>
                </dl>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="details-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="details-title">The details</h2>
          <p>The smaller things a booking site needs, already there.</p>
        </header>
        <ul class="details">
          {
            details.map((detail) => (
