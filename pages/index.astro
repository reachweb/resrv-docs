    background: var(--amber);
  }

  .collection:nth-child(3) h3::before {
    background: var(--third-bar);
  }

  .collection > p {
    margin-top: 0.25rem;
    color: var(--blume-muted-foreground);
    font-size: 0.9375rem;
  }

  .collection .cp-card {
    margin-top: 1.125rem;
  }

  .cal-day.is-closed b {
    color: var(--cp-muted);
  }

  /* Three lines join under the fields and run down through Resrv to the calendar */
  .merge {
    --line: color-mix(in oklab, var(--blume-foreground) 24%, transparent);
    position: relative;
    display: flex;
    justify-content: center;
    padding-block: 2.25rem;
  }

  .merge::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 50%;
    border-left: 1px solid var(--line);
  }

  @media (min-width: 768px) {
    .merge {
      padding-block: 3.25rem 2.25rem;
    }

    /* Stems from the outer columns' centres, joined by a rounded run along the bottom */
    .merge::after {
      content: "";
      position: absolute;
      top: 0;
      left: calc((100% - 2 * var(--gap)) / 6);
      right: calc((100% - 2 * var(--gap)) / 6);
      height: 1.5rem;
      border: 1px solid var(--line);
      border-top: 0;
      border-radius: 0 0 14px 14px;
    }
  }

  .merge-node {
    position: relative;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem 0.625rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--blume-border);
    border-radius: 8px;
    background: var(--blume-background);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  .merge-node code {
    color: var(--blume-muted-foreground);
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    font-weight: 400;
  }

  .week-crop img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* On a phone the whole week would shrink to a sliver. Sunday, Friday and Saturday are empty,
     so the frame shows Monday to Thursday, with all three bookings, at a larger size. */
  @media (max-width: 639px) {
    .week-crop {
      overflow: hidden;
    }

    .week-crop img {
      width: 172%;
      max-width: none;
      margin-left: -25.5%;
    }
  }

  /* Who it's for */
  .who {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .who {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 5rem;
    }
  }

  .who-text p {
    margin-top: 1rem;
    color: var(--blume-muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .uses {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--blume-border);
  }

  @media (min-width: 640px) {
    .uses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  .uses li {
    display: flex;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--blume-border);
  }

  .use-icon {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    background: var(--tint);
    color: var(--blume-accent);
  }

  .uses h3 {
    font-size: 1.0625rem;
  }

  .uses p {
    margin-top: 0.375rem;
    color: var(--blume-muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .uses p a {
    color: var(--blume-accent);
    font-weight: 600;
    white-space: nowrap;
  }

  /* How it works: three staggered bars, as in the logo, mark the three steps */
  .track {
    display: none;
  }

  @media (min-width: 960px) {
    .track {
      position: relative;
      display: block;
      height: 3.25rem;
      margin-bottom: 1.25rem;
    }

    .track i {
      position: absolute;
      height: 0.75rem;
      border-radius: 999px;
    }

    .track i:nth-child(1) {
      top: 0;
      left: 0;
      width: 44%;
      background: var(--orange);
    }

    .track i:nth-child(2) {
      top: 1.25rem;
      left: calc(100% / 3 + 0.5rem);
      width: 44%;
      background: var(--amber);
    }

    .track i:nth-child(3) {
      top: 2.5rem;
      left: calc(200% / 3 + 1rem);
      width: calc(100% / 3 - 1rem);
      background: var(--third-bar);
    }
  }

  .steps {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--blume-border);
    border-radius: var(--radius);
    background: var(--blume-background);
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .step {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .step-visual {
      border-top: 0;
      border-left: 1px solid var(--blume-border);
    }
  }

  @media (min-width: 960px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* Subgrid lines the three panels up, whatever the length of the text above them */
    .step {
      display: grid;
      grid-row: span 2;
      grid-template-rows: subgrid;
      gap: 0;
    }
  }

  .step-text {
    padding: 1.5rem 1.5rem 1.75rem;
  }

  .step-num {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: var(--orange);
    color: var(--ink);
    font-family: var(--wide);
    font-stretch: 112%;
    font-weight: 800;
  }

  .step:nth-child(2) .step-num {
    background: var(--amber);
  }

  .step:nth-child(3) .step-num {
    background: var(--third-bar);
    color: var(--blume-background);
  }

  .step h3 {
    margin-top: 1rem;
    font-size: 1.25rem;
  }

  .step-text p {
    margin-top: 0.5rem;
    color: var(--blume-muted-foreground);
    line-height: 1.6;
  }

  .step-text .more {
    margin-top: 1rem;
  }

  .step-visual {
    display: flex;
    align-items: center;
    min-height: 15rem;
    padding: 1.25rem;
    border-top: 1px solid var(--blume-border);
    background: var(--surface);
  }

  .step-visual > * {
    width: 100%;
  }

  /* Control panel redraws */
  .cp-card {
    overflow: hidden;
    border: 1px solid var(--cp-border);
    border-radius: 10px;
    background: var(--cp-bg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 14px 30px -20px rgb(0 0 0 / 0.35);
    color: var(--cp-text);
    font-family: var(--blume-font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .cp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--cp-border);
    background: var(--cp-page);
    font-weight: 600;
  }

  .cp-body {
    padding: 0.75rem 0.875rem;
  }

  .cp-search {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--cp-border);
    border-radius: 8px;
    color: var(--cp-text);
  }

  .cp-search :global(svg) {
    color: var(--cp-muted);
  }

  .cp-group {
    margin-top: 0.75rem;
    color: var(--cp-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fieldtypes {
    display: grid;
    gap: 0.25rem;
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fieldtypes li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    color: var(--cp-muted);
  }

  .fieldtypes li.is-active {
    background: color-mix(in oklab, var(--cp-primary) 12%, var(--cp-bg));
    color: var(--cp-text);
    font-weight: 600;
  }

  .fieldtypes li.is-active :global(svg) {
    color: var(--cp-primary);
  }

  .cp-select {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--cp-border);
    border-radius: 6px;
    background: var(--cp-bg);
    font-weight: 500;
    font-size: 0.75rem;
  }

  .cal {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
    background: var(--cp-border);
  }

  .cal-dow {
    padding: 0.25rem 0;
    background: var(--cp-bg);
    color: var(--cp-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    text-align: center;
  }

  .cal-day {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.25rem 0.1875rem 0.375rem;
    background: var(--cp-bg);
    font-size: 0.6875rem;
  }

  .cal-day b {
    font-weight: 500;
  }

  .cal-day i {
    border-radius: 3px;
    background: var(--cp-green-bg);
    color: var(--cp-green);
    font-style: normal;
    font-weight: 600;
    font-size: 0.625rem;
    text-align: center;
  }

  .cal-day small {
    font-size: 0.625rem;
    text-align: center;
    white-space: nowrap;
  }

  .code {
    overflow: hidden;
    border: 1px solid var(--blume-border);
    border-radius: 10px;
    background: var(--blume-code-background, var(--blume-background));
  }

  .code-file {
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--blume-border);
    color: var(--blume-muted-foreground);
    font-family: var(--blume-font-mono);
    font-size: 0.6875rem;
  }

  .code pre {
    margin: 0;
    padding: 0.75rem 0.875rem;
    overflow-x: auto;
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
  }


  .code pre + .code-file {
    border-top: 1px solid var(--blume-border);
  }

  .code .t {
    color: var(--blume-foreground);
  }

  .code .a {
    color: var(--blume-accent);
  }

  .code .s {
    color: color-mix(in oklab, var(--blume-foreground) 60%, var(--amber));
  }

  /* Feature splits */
  .split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4.5rem;
    }

    .split.is-reversed .split-text {
      order: 2;
    }
  }

  .split-text > p {
    margin-top: 1rem;
    color: var(--blume-muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .ticks {
    display: grid;
    gap: 0.875rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    display: flex;
    gap: 0.625rem;
    color: var(--blume-muted-foreground);
    line-height: 1.55;
  }

  .ticks :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--blume-accent);
  }

  .ticks a {
    color: var(--blume-accent);
    font-weight: 600;
  }

  .gateways {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .gateways a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--blume-border);
    border-radius: 8px;
    background: var(--blume-background);
    color: var(--blume-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .gateways a:hover {
    border-color: var(--blume-accent);
  }

  .gateways small {
    color: var(--blume-muted-foreground);
    font-weight: 500;
  }

  /* Two panels in one grid cell: the main one behind, a smaller one in front and lower */
  .layered {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
  }

  .layered > :first-child {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  /* On a phone the summary is the panel with the numbers, so it takes ten of the twelve columns */
  .window-float {
    grid-column: 3 / -1;
    grid-row: 2;
    margin-top: -2.5rem;
  }

  @media (min-width: 560px) {
    .layered > :first-child {
      grid-column: 1 / span 9;
    }

    .window-float {
      grid-row: 1;
      margin-top: 3.5rem;
    }

    .window-summary {
      grid-column: 8 / -1;
    }
  }

  .window img {
    display: block;
    width: 100%;
    height: auto;
  }

  .window-paper {
    background: #f3eee6;
  }

  /* The Rooms collection's rates, as the Rates screen lists them: base rate first, the rates
     derived from it indented below */
  .rate-tree {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rate-tree li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    padding: 0.4375rem 0.625rem;
    border: 1px solid var(--cp-border);
    border-radius: 8px;
    background: var(--cp-bg);
  }

  .rate-tree li.is-child {
    margin-left: 1.25rem;
  }

  .rate-tree strong {
    font-weight: 600;
  }

  .grip {
    width: 0.375rem;
    height: 0.75rem;
    background-image: radial-gradient(var(--cp-muted) 1px, transparent 1.2px);
    background-size: 3px 3px;
    opacity: 0.7;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-left: auto;
  }

  .cp-badge {
    padding: 0 0.375rem;
    border: 1px solid var(--cp-border);
    border-radius: 4px;
    color: var(--cp-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  /* Managing reservations */
  .manage-head {
    display: grid;
    gap: 1.5rem 4rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 960px) {
    .manage-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }

    .manage-head .ticks {
      margin-top: 0;
    }
  }

  .manage-head > div > p {
    margin-top: 1rem;
    color: var(--blume-muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    width: max-content;
    max-width: 100%;
    margin-bottom: 1rem;
    padding: 0.25rem;
    overflow-x: auto;
    border: 1px solid var(--blume-border);
    border-radius: 12px;
    background: var(--surface);
  }

  .tabs button {
    flex: none;
    padding: 0.5rem 0.875rem;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--blume-muted-foreground);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 559px) {
    .tabs button {
      padding: 0.5rem 0.5625rem;
      font-size: 0.8125rem;
    }
  }

  .tabs button[aria-selected="true"] {
    background: var(--blume-background);
    color: var(--blume-foreground);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  :global(:root[data-theme="dark"]) .tabs button[aria-selected="true"] {
    background: color-mix(in oklab, var(--blume-foreground) 10%, var(--blume-background));
  }

  .window-cp[hidden] {
    display: none;
  }

  /* Control panel screenshots on a phone: the whole screen would shrink to 4px text, so each
     shows one region at about twice the size. The region comes in as custom properties on the
     .crop box: the image's width and its left and top offsets, all as percentages of the box's
     width. In the viewer every crop is square, so the frame doesn't jump between tabs. */
  .crop {
    overflow: hidden;
  }

  @media (max-width: 559px) {
    .crop img {
      width: var(--crop-w, 100%);
      max-width: none;
      margin: var(--crop-y, 0) 0 0 var(--crop-x, 0);
    }

    .crop.is-square {
      aspect-ratio: 1;
    }
  }

  .cp-btn {
    padding: 0.1875rem 0.625rem;
    border-radius: 6px;
    background: var(--cp-primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .live {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
  }

  /* Details: a plain list in two or three columns, divided by hairlines */
  .details {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--blume-border);
  }

  @media (min-width: 640px) {
    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  @media (min-width: 960px) {
    .details {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }

  .details li {
    padding: 1.25rem 0 1.375rem;
    border-bottom: 1px solid var(--blume-border);
  }

  .details h3 {
    font-size: 1.0625rem;
  }

  .details h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: inherit;
    text-decoration: none;
  }

  .details h3 a :global(svg) {
    flex: none;
    color: var(--blume-accent);
  }

  .details h3 a:hover {
    color: var(--blume-accent);
    text-decoration: underline;
  }

  .details p {
    max-width: 34rem;
    margin-top: 0.375rem;
    color: var(--blume-muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Demo */
  .demo {
    position: relative;
    scroll-margin-top: 4rem;
    border-top: 1px solid var(--blume-border);
    background: color-mix(in oklab, var(--orange) 7%, var(--blume-background));
  }

  :global(:root[data-theme="dark"]) .demo {
    background: color-mix(in oklab, var(--orange) 4%, var(--blume-background));
  }

  /* Right after the collections band, whose bottom hairline already divides the two */
  .tinted + .demo {
    border-top: 0;
  }

  .doors {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each door reads down: what to do, what you'll see, the button that opens it */
  .door {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    overflow: hidden;
    border: 1px solid var(--blume-border);
    border-radius: var(--radius);
    background: var(--blume-background);
    box-shadow: var(--shadow);
  }

  @media (min-width: 640px) {
    .doors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    /* Subgrid lines the two pictures and the two buttons up, whatever the length of the text */
    .door {
      grid-row: span 3;
      grid-template-rows: subgrid;
      gap: 0;
    }
  }

  /* The first two bars of the logo: orange for the site, amber for the control panel */
  .door::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 62%;
    height: 0.5rem;
    border-bottom-right-radius: 999px;
    background: var(--orange);
  }

  .door-cp::before {
    left: 20%;
    border-bottom-left-radius: 999px;
    background: var(--amber);
  }

  .door-body {
    padding: 1.875rem 1.5rem 1.5rem;
  }

  .door h3 {
    font-size: 1.375rem;
  }

  .door-body > p {
    margin-top: 0.5rem;
    color: var(--blume-muted-foreground);
    line-height: 1.6;
  }

  .door-media {
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-block: 1px solid var(--blume-border);
  }

  /* Stretches to the login card's height when that is the taller of the two */
  .door-site .door-media {
    align-self: stretch;
  }

  .door-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .door-foot {
    padding: 1.25rem 1.5rem 1.5rem;
  }

  /* The control panel's sign-in screen, holding the demo login itself */
  .login {
    display: grid;
    place-items: center;
    aspect-ratio: auto;
    padding: 1.25rem;
    background: var(--cp-page);
  }

  .login-card {
    width: min(100%, 17.5rem);
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--cp-border);
    border-radius: 12px;
    background: var(--cp-bg);
    box-shadow: 0 12px 28px -18px rgb(0 0 0 / 0.4);
    color: var(--cp-text);
    font-size: 0.8125rem;
  }

  .login-title {
