---
import Icon from "blume/components/Icon.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import {
  composerPackage,
  demoCpUrl,
  demoLogin,
  demoUrl,
  githubUrl,
  issuesUrl,
  license,
  marketplaceUrl,
  partnerUrl,
  price,
  reachUrl,
  requirements,
  sellerUrl,
  supportEmail,
} from "../site";

// The home page: a product page for Resrv, built on Blume's full-width layout. The docs start
// at /introduction. Every claim here is covered by the docs page linked beside it: change both
// together. The screenshots in public/home/ come from the Resrv Hotel demo, and the control
// panel ones have a light and a dark version that swap with the site's theme. The smaller
// panels redraw the control panel in HTML with the demo's own names and numbers.

const { config } = data;
const host = (url: string) => new URL(url).host;

const uses = [
  {
    icon: "bed-double",
    title: "Hotels and rentals",
    text: "Nightly prices, room types as rates, and breakfast as an option.",
    links: [
      { label: "Rates", href: "/rates" },
      { label: "Options", href: "/options" },
    ],
  },
  {
    icon: "utensils",
    title: "Restaurants",
    text: "Lunch and dinner sittings by date. Set the price to zero and guests book without paying.",
    links: [{ label: "Skip payment", href: "/checkout#skip-payment" }],
  },
  {
    icon: "compass",
    title: "Tours and excursions",
    text: "Guests add several dates and rates for one tour to a cart, then pay for them in one checkout.",
    links: [{ label: "Cart booking", href: "/cart-booking" }],
  },
  {
    icon: "flower-2",
    title: "Spas and wellness",
    text: "Treatments by the day. The date picker shows which days are available and the price of each.",
    links: [{ label: "Availability in the date picker", href: "/availability-search-single#display-availability-in-the-calendar" }],
  },
  {
    icon: "car",
    title: "Car and boat rentals",
    text: "A price for each rental length, and a one-way fee when pickup and return differ.",
    links: [
      { label: "Fixed pricing", href: "/fixed-pricing" },
      { label: "Surcharges", href: "/surcharges" },
    ],
  },
  {
    icon: "ticket",
    title: "Conferences and events",
    text: "A set number of places, and a checkout form you build in Statamic.",
    links: [{ label: "Checkout form", href: "/checkout#checkout-form" }],
  },
];

// The demo's three bookable collections, each with the Availability field in its blueprint. The
// days are the week of 13 to 19 December 2026 as each entry's field shows it, after one booking
// in each (scripts/make-collection-bookings.mjs). The spa is closed on Tuesdays and La Marea on
// Mondays, so those days have no availability.
const week = ["S", "M", "T", "W", "T", "F", "S"];
const collections = [
  {
    title: "Rooms",
    entry: "Sea View Suite",
    unit: "booked by the night",
    rate: "Best Flexible",
    days: [[3, 320], [2, 320], [2, 320], [2, 320], [2, 320], [3, 368], [3, 368]],
  },
  {
    title: "Spa Treatments",
    entry: "Mediterranean Massage",
    unit: "booked by the day",
    rate: "60 minutes",
    days: [[4, 90], [4, 90], null, [3, 90], [4, 90], [4, 90], [4, 90]],
  },
  {
    title: "Restaurant",
    entry: "La Marea",
    unit: "booked by the sitting",
    rate: "Dinner Sitting",
    days: [[16, 55], null, [16, 55], [16, 55], [15, 55], [16, 55], [16, 55]],
  },
];

const fieldtypes = ["Resrv Availability", "Resrv Options", "Resrv Extras", "Resrv Fixed Pricing", "Resrv Cutoff"];

const screens = [
  {
    id: "list",
    label: "Reservations",
    path: "reservations",
    width: 1800,
    height: 909,
    // On phones: the region from x 0 to 900, from the page title to the rate
    crop: "--crop-w: 200%; --crop-x: 0%",
    alt: "Resrv's Reservations list in the Statamic control panel: five confirmed bookings with their entry, rate, dates, deposit, total and customer, and a Create reservation button.",
  },
  {
    id: "reports",
    label: "Reports",
    path: "reports",
    width: 1800,
    height: 1267,
    // On phones: the region from x 40 to 880, the date filter and the report's left cards
    crop: "--crop-w: 214.3%; --crop-x: -4.8%",
    alt: "Reports for 2026: 6 reservations, €4,712.60 revenue, €785.43 average value, and a best sellers table by entry.",
  },
  {
    id: "create",
    label: "Create reservation",
    path: "reservations/create",
    width: 1800,
    height: 1267,
    // On phones: the region from x 950 to 1800, the summary with its discount and total
    crop: "--crop-w: 211.8%; --crop-x: -111.8%",
    alt: "The Create reservation form filled in for the Sea View Suite, 14 to 18 December 2026, with an airport transfer and Continental breakfast, and a summary showing the dynamic pricing discount and a €1,229.40 total.",
  },
];

// The demo's rates for the Rooms collection, as its Rates screen lists them.
const rates = [
  { name: "Best Flexible", child: false, badges: ["All entries", "3 derived rates"] },
  { name: "Bed & Breakfast", child: true, badges: ["Relative", "Shared"] },
  { name: "Advance Saver", child: true, badges: ["Non-refundable", "Relative", "Shared"] },
  { name: "Last-Minute Escape", child: true, badges: ["Non-refundable", "Relative", "Shared"] },
];

const details = [
  {
    title: "Guests manage their booking",
    text: "A status page where guests look up a booking and cancel it within the free cancellation window.",
    href: "/reservation-status",
  },
  {
    title: "Emails you can edit",
    text: "Confirmation, refund and abandoned checkout emails, with subjects and recipients set in the control panel.",
    href: "/emails",
  },
  {
    title: "In your site's languages",
    text: "Translate the frontend's text for each site of a Statamic multisite.",
    href: "/languages",
  },
  {
    title: "Cutoff times",
    text: "Stop bookings a set number of hours before an activity starts.",
    href: "/cutoff",
  },
  {
    title: "Activity log",
    text: "See who changed a price or the availability for a date, and when.",
    href: "/activity-log",
  },
  {
    title: "CSV export",
    text: "Export reservations with the columns you pick, custom checkout fields included.",
    href: "/reservations#export",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/brand/link-preview-1200x630-light.png"
  ogImageAlt="Resrv"
  ogImageSize={{ width: 1200, height: 630 }}
  x={config.x}
  structuredDataEnabled={config.structuredData}
  page={{
    title: "Resrv: a booking system for Statamic",
    description: config.description,
    route: "/",
  }}
>
  <link rel="preload" href="/home/fonts/archivo-wide.woff2" as="font" type="font/woff2" crossorigin />

  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <a class="news" href="/manual-reservations">
          <span class="news-tag">New in 6.5</span>
          <span class="news-text"><span class="news-long">Take bookings by phone and email a payment link</span><span class="news-short">Manual reservations</span></span>
          <Icon name="arrow-right" size={14} />
        </a>
        <h1 id="hero-title">Make any Statamic entry bookable</h1>
        <div class="hero-row">
          <p class="lead">
            Resrv adds availability, rates, extras, checkout and payments to your Statamic site. Guests
            book rooms, tables or tours on your pages, and you manage every reservation in the control
            panel.
          </p>
          <div class="hero-side">
            <div class="actions">
              <a class="btn btn-primary" href="#demo">
                Try the live demo <Icon name="arrow-down" size={16} />
              </a>
              <a class="btn btn-secondary" href={marketplaceUrl}>
                Buy for {price} <Icon name="arrow-up-right" size={16} />
              </a>
              <a class="btn btn-link" href="/introduction">Read the docs</a>
            </div>
            <ul class="facts" aria-label="At a glance">
              <li><Icon name="check" size={14} /> 5 years in production</li>
              <li><Icon name="check" size={14} /> Statamic {requirements.statamic}</li>
              <li><Icon name="check" size={14} /> Free while you develop</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="wrap stage">
        <figure class="shot shot-site">
          <div class="frame">
            <div class="bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="address"><Icon name="lock" size={11} /> {host(demoUrl)}/rooms</span>
            </div>
            {/* The guest site is a desktop page, so smaller screens show less of it at a size
                you can read: two rooms below 900px and the Sea View Suite alone on a phone. Both
                are cut from a 2x capture of the same search,
                brand/statamic/screens/front-search-results.webp. */}
            <picture>
              <source media="(max-width: 559px)" srcset="/home/hero-site-phone.webp" width="816" height="1020" />
              <source media="(max-width: 899px)" srcset="/home/hero-site-tablet.webp" width="1632" height="1182" />
              <img
                src="/home/hero-site.webp"
                width="1600"
                height="1000"
                fetchpriority="high"
                alt="The Resrv Hotel demo's rooms page after a search for 14 to 18 December. Each room shows its discounted total, a free cancellation date and a Book now button: the Sea View Suite is €1,126.40, down from €1,280."
              />
            </picture>
          </div>
          <figcaption><span class="dot is-orange"></span>Guests book on your site</figcaption>
        </figure>
        <figure class="shot shot-cp">
          <div class="frame">
            <div class="bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="address"><Icon name="lock" size={11} /> {host(demoCpUrl)}/cp/resrv/reservations</span>
            </div>
            <div class="crop" style="--crop-w: 250%; --crop-x: -40.9%; --crop-y: -9.7%">
              <img
                class="is-light"
                src="/home/hero-cp-light.webp"
                width="1600"
                height="752"
                alt="Resrv's Reservations list in the Statamic control panel, with five confirmed bookings and their entries, rates, dates, totals and customers."
              />
              <img
                class="is-dark"
                src="/home/hero-cp-dark.webp"
                width="1600"
                height="752"
                alt="Resrv's Reservations list in the Statamic control panel, with five confirmed bookings and their entries, rates, dates, totals and customers."
              />
            </div>
          </div>
          <figcaption><span class="dot is-amber"></span>You manage bookings in Statamic</figcaption>
        </figure>
      </div>
    </section>

    <section class="section tinted" aria-labelledby="any-title">
      <div class="wrap any">
        <header class="section-head">
          <h2 id="any-title">Three collections, one booking system</h2>
          <p>
            The demo hotel sells rooms, spa treatments and restaurant tables. Each comes from its own
            collection with the Availability field in its blueprint, so every entry has its own
            availability and prices. Each day below shows how many are left and the price. One Resrv
            install handles all three, and you see every reservation on one calendar.
          </p>
          <p class="any-links">
            <a class="more" href="/availability">Availability field <Icon name="arrow-right" size={14} /></a>
            <a class="more" href="/reservations#reservations-calendar">Reservations Calendar <Icon name="arrow-right" size={14} /></a>
          </p>
        </header>

        <ol class="collections">
          {
            collections.map((collection) => (
              <li class="collection">
                <h3>{collection.title}</h3>
                <p>
                  {collection.entry}, {collection.unit}
                </p>
                <div class="cp-card" aria-hidden="true">
                  <p class="cp-head">
                    <span class="cp-month">December 2026</span>
                    <span class="cp-select">
                      {collection.rate} <Icon name="chevron-down" size={12} />
                    </span>
                  </p>
                  <div class="cal">
                    {week.map((d) => <span class="cal-dow">{d}</span>)}
                    {
                      collection.days.map((day, i) => (
                        <span class:list={["cal-day", { "is-closed": !day }]}>
                          <b>{13 + i}</b>
                          {day && <i># {day[0]}</i>}
                          {day && <small>€{day[1]}</small>}
                        </span>
                      ))
                    }
                  </div>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="merge" aria-hidden="true">
          <p class="merge-node"><span>Resrv</span> <code>{composerPackage}</code></p>
        </div>

        <figure class="shot shot-week">
          <div class="frame">
            <div class="bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="address"><Icon name="lock" size={11} /> {host(demoCpUrl)}/cp/resrv/reservations/calendar</span>
            </div>
            <div class="week-crop">
              <img
                class="is-light"
                src="/home/cp-calendar-light.webp"
                width="2588"
                height="488"
                loading="lazy"
                alt="The Reservations Calendar in the control panel for the week of 13 to 19 December 2026: the Sea View Suite booked from Monday to Friday, a Mediterranean Massage on Wednesday and a dinner sitting at La Marea on Thursday."
              />
              <img
                class="is-dark"
                src="/home/cp-calendar-dark.webp"
                width="2588"
                height="488"
                loading="lazy"
                alt="The Reservations Calendar in the control panel for the week of 13 to 19 December 2026: the Sea View Suite booked from Monday to Friday, a Mediterranean Massage on Wednesday and a dinner sitting at La Marea on Thursday."
              />
            </div>
          </div>
          <figcaption><span class="dot is-amber"></span>Every booking on one calendar</figcaption>
        </figure>
      </div>
    </section>

    <section class="section demo" id="demo" aria-labelledby="demo-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="demo-title">Try it on the Resrv Hotel</h2>
        </header>
        <ol class="doors">
          <li class="door door-site">
            <div class="door-body">
              <h3>Book on the hotel site</h3>
              <p>Pick your dates, choose a rate, add extras and go through checkout. The demo only offers bank transfer, so you won't need a card.</p>
            </div>
            <a class="door-media" href={demoUrl} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <img
                src="/home/demo-hotel.webp"
                width="1400"
                height="875"
                loading="lazy"
                alt=""
              />
            </a>
            <div class="door-foot">
              <a class="btn btn-primary" href={demoUrl} target="_blank" rel="noopener">
                Open the hotel site <Icon name="arrow-up-right" size={16} /><span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
          </li>
          <li class="door door-cp">
            <div class="door-body">
              <h3>Log in to the control panel</h3>
              <p>Find your booking under Reservations, then look around the calendar, rates and reports.</p>
            </div>
            <div class="door-media login">
              <div class="login-card">
                <p class="login-title" aria-hidden="true">Sign in with email</p>
                <dl class="creds" aria-label="Demo login">
                  <div><dt>Email</dt><dd>{demoLogin.email}</dd></div>
                  <div><dt>Password</dt><dd>{demoLogin.password}</dd></div>
                </dl>
                <p class="login-btn" aria-hidden="true">Continue</p>
              </div>
            </div>
            <div class="door-foot">
              <a class="btn btn-secondary" href={demoCpUrl} target="_blank" rel="noopener">
                Open the control panel <Icon name="arrow-up-right" size={16} /><span class="sr-only">(opens in a new tab)</span>
              </a>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="who-title">
      <div class="wrap who">
        <div class="who-text">
          <h2 id="who-title">For Statamic sites that take bookings</h2>
          <p>
            Resrv is for developers and agencies who build with Statamic, and for the businesses they
            build for. You set up the collections and templates. Your client manages availability,
            prices and reservations in the control panel.
          </p>
          <a class="more" href="/core-concepts">How Resrv works <Icon name="arrow-right" size={14} /></a>
        </div>
        <ul class="uses">
          {
            uses.map((use) => (
              <li>
                <span class="use-icon">
                  <Icon name={use.icon} size={20} />
                </span>
                <div>
                  <h3>{use.title}</h3>
                  <p>
                    {use.text}{" "}
                    {use.links.map((link, i) => (
                      <>
                        {i > 0 && <span aria-hidden="true"> · </span>}
                        <a href={link.href}>{link.label}</a>
                      </>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section tinted" aria-labelledby="how-title">
      <div class="wrap">
        <header class="section-head">
          <h2 id="how-title">From entry to booking in three steps</h2>
          <p>Resrv builds on Statamic's entries, blueprints and forms, so it fits into a site you already have.</p>
        </header>
        <div class="track" aria-hidden="true"><i></i><i></i><i></i></div>
        <ol class="steps">
          <li class="step">
            <div class="step-text">
              <span class="step-num">1</span>
              <h3>Add the Availability field</h3>
              <p>In a collection's blueprint, add a field and pick Resrv Availability. Every entry in that collection can now take bookings.</p>
              <a class="more" href="/availability">Availability field <Icon name="arrow-right" size={14} /></a>
            </div>
            <div class="step-visual" aria-hidden="true">
              <div class="cp-card">
                <p class="cp-head">Add field</p>
                <div class="cp-body">
                  <p class="cp-search"><Icon name="search" size={13} /> resrv</p>
                  <p class="cp-group">Special</p>
                  <ul class="fieldtypes">
                    {
                      fieldtypes.map((name, i) => (
                        <li class:list={{ "is-active": i === 0 }}>
                          <Icon name={i === 0 ? "calendar-days" : "square-plus"} size={14} />
                          {name}
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </li>
          <li class="step">
            <div class="step-text">
              <span class="step-num">2</span>
              <h3>Set availability and prices</h3>
              <p>Fill each entry's calendar with how many units are free each day and what they cost. Add rates for room types or pricing tiers. A relative rate takes its prices from a base rate, and a shared rate uses the base rate's inventory.</p>
              <a class="more" href="/rates">Rates <Icon name="arrow-right" size={14} /></a>
            </div>
            <div class="step-visual" aria-hidden="true">
              <div class="cp-card">
                <p class="cp-head"><span>Rates</span><span class="cp-btn">Add rate</span></p>
                <div class="cp-body">
                  <ul class="rate-tree">
                    {
                      rates.map((rate) => (
                        <li class:list={{ "is-child": rate.child }}>
                          <span class="grip" />
                          <span class="live" />
                          <strong>{rate.name}</strong>
                          <span class="badges">
                            {rate.badges.map((badge) => <span class="cp-badge">{badge}</span>)}
                          </span>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
          </li>
          <li class="step">
            <div class="step-text">
              <span class="step-num">3</span>
              <h3>Add the Livewire components</h3>
              <p>Put the search, results and checkout components in your templates. Publish their Blade views to change any part, and style them with Tailwind.</p>
              <a class="more" href="/frontend-setup">Frontend setup <Icon name="arrow-right" size={14} /></a>
            </div>
            <div class="step-visual" aria-hidden="true">
              <div class="code">
                <p class="code-file">rooms/show.antlers.html</p>
                <pre><code><span class="t">{"{{ livewire:availability-search"}</span>
    <span class="a">:entry</span>=<span class="s">"id"</span> <span class="t">{"}}"}</span>
<span class="t">{"{{ livewire:availability-results"}</span>
    <span class="a">:entry</span>=<span class="s">"id"</span> <span class="t">{"}}"}</span></code></pre>
                <p class="code-file">checkout.antlers.html</p>
                <pre><code><span class="t">{"{{ livewire:checkout }}"}</span></code></pre>
              </div>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="checkout-title">
      <div class="wrap split is-reversed">
        <div class="split-text">
          <h2 id="checkout-title">A checkout with extras, discounts and payments</h2>
          <p>
            The checkout component takes guests from extras to their details to payment. You build the
            form in Statamic's form builder.
          </p>
          <ul class="ticks">
            <li><Icon name="check" size={16} /><span>Change prices by the dates of a stay, its length or how far ahead it's booked. Coupons use the same rules. <a href="/dynamic-pricing">Dynamic pricing</a></span></li>
            <li><Icon name="check" size={16} /><span>Affiliate links credit partners with the bookings they send, and you record the fee each one earns. <a href="/affiliates">Affiliates</a></span></li>
          </ul>
          <ul class="gateways" aria-label="Payment gateways">
            <li><a href="/stripe">Stripe</a></li>
            <li><a href="/payment-gateways#the-offline-gateway">Bank transfer</a></li>
            <li><a href="/mollie">Mollie <small>add-on</small></a></li>
            <li><a href="/custom-payment-gateway">Your own gateway</a></li>
          </ul>
          <a class="more" href="/checkout">Checkout <Icon name="arrow-right" size={14} /></a>
        </div>
        <div class="split-visual layered">
          <div class="window window-paper">
            <img
              src="/home/checkout-extras.webp"
              width="1400"
              height="1243"
              loading="lazy"
              alt="The demo's checkout, step 1 of 3, Extras and options: Continental breakfast and a King bed chosen, and the airport transfer switched on."
            />
          </div>
          <div class="window window-float window-summary">
            <img
              src="/home/checkout-summary.webp"
              width="848"
              height="1340"
              loading="lazy"
              alt="The checkout summary for the Sea View Suite, 14 to 18 December: the COASTAL10 coupon applied, breakfast, bed setup, airport transfer and champagne, and a €1,161.76 total."
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section tinted" aria-labelledby="manage-title">
      <div class="wrap">
        <div class="manage-head">
          <div>
            <h2 id="manage-title">Every booking in the control panel</h2>
            <p>
              Reservations live in Statamic next to your content, so your client manages them with the
              login they already have.
            </p>
            <a class="more" href="/reservations">Reservations <Icon name="arrow-right" size={14} /></a>
          </div>
          <ul class="ticks">
            <li><Icon name="check" size={16} /><span>Refund a booking through the gateway the guest paid with, and its dates become available again.</span></li>
            <li><Icon name="check" size={16} /><span>Book for a guest on the phone and email them a link to pay. <a href="/manual-reservations">Manual reservations</a></span></li>
          </ul>
        </div>

        <div class="viewer" data-viewer>
          <div class="tabs" role="tablist" aria-label="Control panel screens">
            {
              screens.map((screen, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${screen.id}`}
                  aria-controls={`panel-${screen.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                >
                  {screen.label}
                </button>
              ))
            }
