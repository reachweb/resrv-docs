  }

  /* Control panel redraws */
  .cp-card {
    overflow: hidden;
    border: 1px solid var(--cp-border);
    border-radius: 10px;
    background: var(--cp-bg);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 14px 30px -20px rgb(0 0 0 / 0.35);
    color: var(--cp-text);
    font-family: var(--blume-font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .cp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--cp-border);
    background: var(--cp-page);
    font-weight: 600;
  }

  .cp-body {
    padding: 0.75rem 0.875rem;
  }

  .cp-search {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--cp-border);
    border-radius: 8px;
    color: var(--cp-text);
  }

  .cp-search :global(svg) {
    color: var(--cp-muted);
  }

  .cp-group {
    margin-top: 0.75rem;
    color: var(--cp-muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .fieldtypes {
    display: grid;
    gap: 0.25rem;
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fieldtypes li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.5rem;
    border-radius: 6px;
    color: var(--cp-muted);
  }

  .fieldtypes li.is-active {
    background: color-mix(in oklab, var(--cp-primary) 12%, var(--cp-bg));
    color: var(--cp-text);
    font-weight: 600;
  }

  .fieldtypes li.is-active :global(svg) {
    color: var(--cp-primary);
  }

  .cp-select {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--cp-border);
    border-radius: 6px;
    background: var(--cp-bg);
    font-weight: 500;
    font-size: 0.75rem;
  }

  .cal {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1px;
    background: var(--cp-border);
  }

  .cal-dow {
    padding: 0.25rem 0;
    background: var(--cp-bg);
    color: var(--cp-muted);
    font-size: 0.6875rem;
    font-weight: 600;
    text-align: center;
  }

  .cal-day {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.25rem 0.1875rem 0.375rem;
    background: var(--cp-bg);
    font-size: 0.6875rem;
  }

  .cal-day b {
    font-weight: 500;
  }

  .cal-day i {
    border-radius: 3px;
    background: var(--cp-green-bg);
    color: var(--cp-green);
    font-style: normal;
    font-weight: 600;
    font-size: 0.625rem;
    text-align: center;
  }

  .cal-day small {
    font-size: 0.625rem;
    text-align: center;
    white-space: nowrap;
  }

  .code {
    overflow: hidden;
    border: 1px solid var(--blume-border);
    border-radius: 10px;
    background: var(--blume-code-background, var(--blume-background));
  }

  .code-file {
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--blume-border);
    color: var(--blume-muted-foreground);
    font-family: var(--blume-font-mono);
    font-size: 0.6875rem;
  }

  .code pre {
    margin: 0;
    padding: 0.75rem 0.875rem;
    overflow-x: auto;
    font-family: var(--blume-font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .code pre + .code-file {
    border-top: 1px solid var(--blume-border);
  }

  .code .t {
    color: var(--blume-foreground);
  }

  .code .a {
    color: var(--blume-accent);
  }

  .code .s {
    color: color-mix(in oklab, var(--blume-foreground) 60%, var(--amber));
  }

  /* Feature splits */
  .split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4.5rem;
    }

    .split.is-reversed .split-text {
      order: 2;
    }
  }

  .split-text > p {
    margin-top: 1rem;
    color: var(--blume-muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .ticks {
    display: grid;
    gap: 0.875rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ticks li {
    display: flex;
    gap: 0.625rem;
    color: var(--blume-muted-foreground);
    line-height: 1.55;
  }

  .ticks :global(svg) {
    flex: none;
    margin-top: 0.2rem;
    color: var(--blume-accent);
  }

  .ticks a {
    color: var(--blume-accent);
    font-weight: 600;
  }

  .gateways {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .gateways a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--blume-border);
    border-radius: 8px;
    background: var(--blume-background);
    color: var(--blume-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  .gateways a:hover {
    border-color: var(--blume-accent);
  }

  .gateways small {
    color: var(--blume-muted-foreground);
    font-weight: 500;
  }

  /* Two panels in one grid cell: the main one behind, a smaller one in front and lower */
  .layered {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
  }

  .layered > :first-child {
    grid-column: 1 / -1;
    grid-row: 1;
  }

  .window-float {
    grid-column: 5 / -1;
    grid-row: 2;
    margin-top: -2.5rem;
  }

  @media (min-width: 560px) {
    .layered > :first-child {
      grid-column: 1 / span 9;
    }

    .window-float {
      grid-row: 1;
      margin-top: 3.5rem;
    }

    .window-summary {
      grid-column: 8 / -1;
    }
  }

  /* The rates screen and the booking box they produce, side by side */
  .pairing {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 560px) {
    .pairing {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .window-widget {
      margin-top: 3rem;
    }
  }

  @media (max-width: 559px) {
    .window-widget {
      width: min(100%, 18rem);
      margin-inline: auto;
    }
  }

  .window img {
    display: block;
    width: 100%;
    height: auto;
  }

  .window-paper {
    background: #f3eee6;
  }

  .rates-card {
    font-size: 0.875rem;
  }

  .cp-label {
    font-weight: 600;
  }

  .cp-field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.375rem;
    padding: 0.4375rem 0.625rem;
    border: 1px solid var(--cp-border);
    border-radius: 6px;
  }

  .rate-tree {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0.25rem;
    padding: 0;
    list-style: none;
  }

  .rate-tree li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    padding: 0.5625rem 0.75rem;
    border: 1px solid var(--cp-border);
    border-radius: 8px;
    background: var(--cp-bg);
  }

  .rate-tree li.is-child {
    margin-left: 1.25rem;
  }

  .rate-tree strong {
    font-weight: 600;
  }

  .grip {
    width: 0.375rem;
    height: 0.75rem;
    background-image: radial-gradient(var(--cp-muted) 1px, transparent 1.2px);
    background-size: 3px 3px;
    opacity: 0.7;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-left: auto;
  }

  .cp-badge {
    padding: 0 0.375rem;
    border: 1px solid var(--cp-border);
    border-radius: 4px;
    color: var(--cp-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  /* Managing reservations */
  .manage-head {
    display: grid;
    gap: 1.5rem 4rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 960px) {
    .manage-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }

    .manage-head .ticks {
      margin-top: 0;
    }
  }

  .manage-head > div > p {
    margin-top: 1rem;
    color: var(--blume-muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .tabs {
    display: flex;
    gap: 0.25rem;
    width: max-content;
    max-width: 100%;
    margin-bottom: 1rem;
    padding: 0.25rem;
    overflow-x: auto;
    border: 1px solid var(--blume-border);
    border-radius: 12px;
    background: var(--surface);
  }

  .tabs button {
    flex: none;
    padding: 0.5rem 0.875rem;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--blume-muted-foreground);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 559px) {
    .tabs button {
      padding: 0.5rem 0.5625rem;
      font-size: 0.8125rem;
    }
  }

  .tabs button[aria-selected="true"] {
    background: var(--blume-background);
    color: var(--blume-foreground);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
  }

  :global(:root[data-theme="dark"]) .tabs button[aria-selected="true"] {
    background: color-mix(in oklab, var(--blume-foreground) 10%, var(--blume-background));
  }

  .window-cp[hidden] {
    display: none;
  }

  /* Dynamic pricing panels */
  .stack {
    display: grid;
    gap: 1rem;
  }

  .pair {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 560px) {
    .pair {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }
  }

  .cp-btn {
    padding: 0.1875rem 0.625rem;
    border-radius: 6px;
    background: var(--cp-primary);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .campaigns {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0.75rem;
    list-style: none;
  }

  .campaigns li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--cp-border);
    border-radius: 8px;
    font-weight: 500;
  }

  .live {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #22c55e;
  }

  .cp-tag {
    padding: 0 0.375rem;
    border: 1px solid var(--cp-border);
    border-radius: 4px;
    background: var(--cp-page);
    color: var(--cp-muted);
    font-size: 0.6875rem;
  }

  .summary-entry {
    display: grid;
    gap: 0.125rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--cp-border);
  }

  .summary-entry span {
    color: var(--cp-muted);
  }

  .summary dl,
  .affiliate dl {
    display: grid;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
  }

  .summary dl div,
  .affiliate dl div {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .summary dt,
  .affiliate dt {
    color: var(--cp-muted);
  }

  .summary dd,
  .affiliate dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .summary .is-discount dd {
    color: var(--cp-green);
    font-weight: 600;
  }

  .summary .is-total {
    margin-top: 0.25rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--cp-border);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .summary .is-total dt {
    color: var(--cp-text);
  }

  .affiliate {
    display: grid;
    gap: 0.375rem;
  }

  .affiliate code {
    justify-self: start;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    background: var(--cp-page);
    font-family: var(--blume-font-mono);
    font-size: 0.6875rem;
  }

  .affiliate dl {
    margin-top: 0.25rem;
  }

  /* Details */
  .details {
    display: grid;
    gap: 2.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .details {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .details li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--blume-border);
  }

  .icon-tile {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9px;
    background: var(--tint);
    color: var(--blume-accent);
  }

  .details h3 {
    margin-top: 0.875rem;
    font-size: 1.0625rem;
  }

  .details h3 a {
    color: inherit;
    text-decoration: none;
  }

  .details h3 a:hover {
    color: var(--blume-accent);
    text-decoration: underline;
  }

  .details p {
    margin-top: 0.375rem;
    color: var(--blume-muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Demo */
  .demo {
    position: relative;
    scroll-margin-top: 4rem;
    border-top: 1px solid var(--blume-border);
    background: color-mix(in oklab, var(--orange) 7%, var(--blume-background));
  }

  :global(:root[data-theme="dark"]) .demo {
    background: color-mix(in oklab, var(--orange) 4%, var(--blume-background));
  }

  .doors {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 860px) {
    .doors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--blume-border);
    border-radius: var(--radius);
    background: var(--blume-background);
    box-shadow: var(--shadow);
  }

  /* The first two bars of the logo: orange for the site, amber for the control panel */
  .door::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 62%;
    height: 0.5rem;
    border-bottom-right-radius: 999px;
    background: var(--orange);
  }

  .door-cp::before {
    left: 20%;
    border-bottom-left-radius: 999px;
    background: var(--amber);
  }

  .door-media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--blume-border);
  }

  .door-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .login {
    display: grid;
    place-items: center;
    padding: 1.5rem;
    background: var(--cp-page);
  }

  @media (max-width: 559px) {
    .door-media.login {
      aspect-ratio: auto;
      padding-block: 1.75rem;
    }
  }

  .login-card {
    width: min(100%, 17rem);
    padding: 1.125rem;
    border: 1px solid var(--cp-border);
    border-radius: 12px;
    background: var(--cp-bg);
    box-shadow: 0 12px 28px -18px rgb(0 0 0 / 0.4);
    color: var(--cp-text);
    font-size: 0.75rem;
  }

  .login-title {
    margin-bottom: 0.625rem;
    font-weight: 600;
    font-size: 0.875rem;
    text-align: center;
  }

  .login-label {
    margin-top: 0.5rem;
    font-weight: 600;
  }

  .login-input {
    margin-top: 0.25rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--cp-border);
    border-radius: 6px;
  }

  .login-input.is-secret {
    letter-spacing: 0.1em;
  }

  .login-btn {
    margin-top: 0.875rem;
    padding: 0.4375rem;
    border-radius: 6px;
    background: var(--cp-primary);
    color: #fff;
    font-weight: 600;
    text-align: center;
  }

  .door-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
  }

  .door-step {
    color: var(--blume-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .door h3 {
    margin-top: 0.25rem;
    font-size: 1.375rem;
  }

  .door-body > p:not(.door-step) {
    margin-top: 0.5rem;
    color: var(--blume-muted-foreground);
    line-height: 1.6;
  }

  .door-body .btn {
    margin-top: auto;
  }

  .door-body > p + .btn,
  .creds + .btn {
    margin-top: 1.25rem;
  }

  .creds {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 1rem 0 0;
  }

  .creds div {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .creds dt {
    color: var(--blume-muted-foreground);
    font-size: 0.875rem;
  }

  .creds dd {
    margin: 0;
  }

  .creds code {
    padding: 0.125rem 0.375rem;
    border-radius: 6px;
    background: var(--blume-code-background, var(--surface));
    font-family: var(--blume-font-mono);
    font-size: 0.8125rem;
  }

  /* Pricing */
  .pricing {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .pricing {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 5rem;
    }
  }

  .pricing-text > p {
    max-width: 32rem;
    margin-top: 1rem;
    color: var(--blume-muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .reqs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    max-width: 30rem;
    margin: 2rem 0 0;
  }

  .reqs div {
    padding-top: 0.75rem;
    border-top: 1px solid var(--blume-border);
  }

  .reqs dt {
    color: var(--blume-muted-foreground);
    font-size: 0.875rem;
  }

  .reqs dd {
    margin: 0.125rem 0 0;
    color: var(--blume-foreground);
    font-weight: 600;
  }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem 1.75rem;
    overflow: hidden;
    border: 1px solid var(--blume-border);
    border-radius: var(--radius);
    background: var(--blume-background);
    box-shadow: var(--shadow);
  }

  .plan::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(to right, var(--orange), var(--amber));
  }

  .plan-name {
    color: var(--blume-muted-foreground);
    font-weight: 600;
  }

  .plan-price {
    margin-top: 0.5rem;
    color: var(--blume-foreground);
    font-family: var(--wide);
    font-size: 4rem;
    font-stretch: 125%;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .plan-terms {
    margin-top: 0.75rem;
    color: var(--blume-foreground);
    font-weight: 600;
  }

  .plan-list {
    display: grid;
    gap: 0.625rem;
    margin: 1.5rem 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--blume-border);
    list-style: none;
    color: var(--blume-muted-foreground);
  }

  .plan-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .plan-list :global(svg) {
    flex: none;
    color: var(--blume-accent);
  }

  .plan-list a,
  .plan-foot a {
    color: var(--blume-accent);
    font-weight: 600;
  }

  .plan-foot {
    margin-top: 1rem;
    color: var(--blume-muted-foreground);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* Made by Reach */
  .partner {
    display: inline-block;
    margin-top: 1.75rem;
  }

  .partner img {
    display: block;
    width: 112px;
    height: auto;
  }

  :global(:root[data-theme="dark"]) .partner img {
    padding: 0.5rem;
    border-radius: 10px;
    background: #fff;
  }

  .team-links {
    display: flex;
    flex-wrap: wrap;
